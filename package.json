{
  "name": "moje-sady",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Moje Sady – mapa pozemků a plánování ovocného sadu s otevřenými daty",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.data.json && vite build",
    "build:sqlite-qa": "vite build --config vite.sqlite-qa.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.data.json",
    "test": "node scripts/test-all.mjs",
    "test:sqlite": "playwright test",
    "data:download": "node scripts/prepare-open-data.mjs",
    "data:package": "node scripts/package-open-data.mjs",
    "data:rainfall": "node scripts/fill-rainfall.mjs",
    "data:verify": "node scripts/verify-open-data.mjs",
    "test:regional": "node scripts/test-regional.mjs",
    "test:regional-status": "node scripts/test-regional-status.mjs",
    "test:regional-lifecycle": "node scripts/test-regional-lifecycle.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "test:automatic-coverage": "node scripts/test-automatic-coverage.mjs",
    "test:map-preferences": "node scripts/test-map-preferences.mjs",
    "test:categories": "node scripts/test-parcel-categories.mjs",
    "test:overview": "node scripts/test-parcel-overview.mjs",
    "test:manual-inputs": "node scripts/test-manual-inputs.mjs",
    "test:planting": "node scripts/test-planting-geometry.mjs",
    "test:planting-profiles": "node scripts/test-planting-profiles.mjs",
    "test:planting-economics": "node scripts/test-planting-economics.mjs",
    "test:planting-persistence": "node scripts/test-planting-persistence.mjs",
    "test:geometry": "node scripts/test-geometry-operations.mjs",
    "test:localities": "node scripts/test-locality-search.mjs",
    "test:parcels": "node scripts/test-parcel-eligibility.mjs",
    "test:coverage": "node scripts/test-parcel-coverage.mjs",
    "test:migration": "node scripts/test-no-demo.mjs",
    "test:map-viewport": "node scripts/test-map-viewport.mjs",
    "test:regional-climate": "node scripts/test-regional-climate.mjs",
    "test:coverage-preservation": "node scripts/test-coverage-preservation.mjs",
    "test:regional-deferred": "node scripts/test-regional-deferred.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.51.0",
    "@turf/area": "^7.1.0",
    "@turf/bbox": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "@turf/intersect": "^7.1.0",
    "@turf/length": "^7.1.0",
    "@turf/union": "^7.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "^24.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
