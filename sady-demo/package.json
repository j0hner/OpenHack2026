{
  "name": "moje-sady",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Moje Sady – mapa pozemků a plánování ovocného sadu s otevřenými daty",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "data:download": "node scripts/prepare-open-data.mjs",
    "data:package": "node scripts/package-open-data.mjs",
    "data:rainfall": "node scripts/fill-rainfall.mjs",
    "data:verify": "node scripts/verify-open-data.mjs",
    "test:regional": "node scripts/test-regional.mjs",
    "test:geometry": "node scripts/test-geometry-operations.mjs",
    "test:localities": "node scripts/test-locality-search.mjs",
    "test:parcels": "node scripts/test-parcel-eligibility.mjs",
    "test:coverage": "node scripts/test-parcel-coverage.mjs",
    "test:migration": "node scripts/test-no-demo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tabler/icons-react": "3.51.0",
    "@turf/area": "^7.1.0",
    "@turf/bbox": "^7.1.0",
    "@turf/helpers": "^7.1.0",
    "@turf/intersect": "^7.1.0",
    "@turf/length": "^7.1.0",
    "@turf/union": "^7.1.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
